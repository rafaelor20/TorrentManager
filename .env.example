# ==============================================================================
#                      TORRENT MANAGER — ARQUIVO .ENV
# ==============================================================================
# Este arquivo permite configurar a porta do servidor e parâmetros da aplicação.
# Coloque este arquivo com o nome ".env" na mesma pasta do executável
# (ex: release/.env ou ao lado de TorrentManager.exe) ou na raiz do projeto.
# ==============================================================================

# Porta do Servidor Web local (Padrão: 3000)
# Altere para a porta desejada (ex: 3000, 8080, 4000, 5000)
PORT=3000

# Endereço de escuta do servidor (Padrão: 0.0.0.0 para acesso local e na rede)
HOST=0.0.0.0

# Cliente BitTorrent ativo (Padrão: qbittorrent | Opções: qbittorrent, mock)
TORRENT_CLIENT_TYPE=qbittorrent

# ==============================================================================
# PARÂMETROS DO CLIENTE BITTORRENT (QBITTORRENT)
# ==============================================================================
# Endereço do qBittorrent Web UI
QBIT_HOST=localhost

# Porta do Web UI do qBittorrent (Padrão: 8877 ou 8080)
QBIT_PORT=8877

# Usuário do Web UI do qBittorrent
QBIT_USER=admin

# Senha do Web UI do qBittorrent
QBIT_PASSWORD=admin

# Utilizar conexão segura HTTPS (true ou false)
QBIT_HTTPS=false

# Intervalo em segundos para sincronização automática em segundo plano
QBIT_REFRESH=10

# Tempo limite de resposta em milissegundos para a API do qBittorrent
QBIT_TIMEOUT=5000
